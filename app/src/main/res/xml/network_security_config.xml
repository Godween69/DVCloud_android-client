<?xml version="1.0" encoding="utf-8"?>
<!-- Безопасность сети: только HTTPS, cleartext (HTTP) запрещён -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
